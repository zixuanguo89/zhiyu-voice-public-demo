# Keep the default loopback bind for the competition sandbox.
HOST=127.0.0.1
PORT=8765
DATABASE_URL=sqlite:///artifacts/app.sqlite3
BUSINESS_DATABASE=artifacts/business.sqlite3
BUSINESS_ADAPTER=mock
ARTIFACT_DIR=artifacts
ADMIN_TOKEN=
RECORDS_ADMIN_TOKEN=
ENABLE_DEMO_FAULTS=1
SESSION_TTL=3600
CONFIRMATION_TTL=120

# Set all three providers to dashscope to activate microphone mode.
ASR_PROVIDER=mock
ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_MODEL=paraformer-realtime-v2
ASR_API_KEY=
LLM_PROVIDER=mock
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen-plus
LLM_API_KEY=
TTS_PROVIDER=mock
TTS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_MODEL=cosyvoice-v2
TTS_VOICE=longxiaochun_v2
TTS_API_KEY=
# DASHSCOPE_API_KEY can be used instead of the three individual keys.
